---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  <div id="experience-main-container" class="relative overflow-hidden min-h-[400px]">
    
    <div id="experience-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]">
      {experience.map((exp, index) => (
        <div class="group flex flex-col rounded-[2rem] border border-neutral-200 bg-white p-6 md:p-8 text-left transition-all duration-500 hover:shadow-xl hover:shadow-neutral-200/40">
          <div class="flex items-start gap-4 mb-5">
            {exp.logo && (
              <div class="w-12 h-12 rounded-xl bg-neutral-50 border border-neutral-100 flex items-center justify-center overflow-hidden p-1.5 flex-shrink-0 shadow-sm">
                <img src={exp.logo} alt={`Logo ${exp.company}`} class="w-full h-full object-contain" />
              </div>
            )}
            <div>
              <h3 class="text-lg md:text-xl font-black text-neutral-900 tracking-tightest leading-snug">{exp.position}</h3>
              <p class="text-xs font-bold text-neutral-500 mt-0.5">{exp.company} • {exp.location}</p>
            </div>
          </div>

          <p class="text-xs text-neutral-400 font-black uppercase tracking-wider mb-4">
            {exp.startDate} — {exp.endDate}
          </p>
          
          <p class="text-xs md:text-sm text-neutral-600 line-clamp-2 mb-6 leading-relaxed font-medium">
            {Array.isArray(exp.summary) ? exp.summary[0] : exp.summary}
          </p>
          
          <div class="mt-auto pt-4 border-t border-neutral-100 flex">
            <button 
              type="button"
              data-experience-target={index}
              class="view-exp-details-btn inline-flex items-center gap-3 px-5 py-2.5 rounded-xl border border-neutral-200 bg-white text-[9px] font-black text-neutral-900 uppercase tracking-[0.2em] hover:bg-black hover:text-white hover:border-black transition-all duration-300 cursor-pointer group/btn shadow-sm shadow-neutral-50"
            >
              <span>View Details</span>
              <span class="text-sm leading-none transform transition-transform duration-300 group-hover/btn:translate-x-0.5">→</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    {experience.map((exp, index) => (
      <div 
        id={`exp-detail-${index}`} 
        class="experience-detail-view hidden absolute top-0 left-0 w-full opacity-0 translate-x-12 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]"
      >
        <div class="flex mb-6">
          <button class="back-to-exp-grid inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-200 bg-white text-[9px] font-black uppercase tracking-[0.2em] text-neutral-900 hover:bg-black hover:text-white transition-all duration-300 cursor-pointer group shadow-sm shadow-neutral-100">
            <span class="text-sm leading-none transition-transform group-hover:-translate-x-0.5">←</span> Back to Experience
          </button>
        </div>

        <div class="rounded-[2rem] border border-neutral-200 bg-white overflow-hidden p-6 md:p-10 max-w-7xl mx-auto shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-neutral-100 pb-6 mb-8">
            <div class="flex items-center gap-4">
              {exp.logo && (
                <div class="w-16 h-16 rounded-2xl bg-neutral-50 border border-neutral-100 flex items-center justify-center overflow-hidden p-2 flex-shrink-0 shadow-sm">
                  <img src={exp.logo} alt={`Logo ${exp.company}`} class="w-full h-full object-contain" />
                </div>
              )}
              <div>
                <h2 class="text-2xl md:text-3xl font-black text-neutral-900 tracking-tightest leading-tight">{exp.position}</h2>
                <p class="text-sm font-bold text-neutral-500 mt-1">{exp.company} • {exp.location}</p>
              </div>
            </div>
            <div class="text-left md:text-right">
              <span class="inline-block px-4 py-1.5 rounded-full bg-neutral-50 border border-neutral-200 text-[10px] font-black text-neutral-500 uppercase tracking-widest">
                {exp.startDate} — {exp.endDate}
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2 space-y-6">
              <div class="space-y-4">
                <h4 class="flex items-center gap-3 text-[14px] font-black text-black uppercase tracking-[0.3em]">
                  <span class="w-4 h-[1.5px] bg-black"></span> Job Details
                </h4>
                {Array.isArray(exp.summary) ? (
                  <ul class="space-y-3.5">
                    {exp.summary.map((log) => (
                      <li class="flex items-start gap-3 text-xs md:text-sm text-neutral-600 font-medium leading-relaxed text-justify">
                        <svg class="mt-1 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>{log}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-neutral-600 text-sm md:text-base text-justify leading-relaxed font-medium opacity-90">{exp.summary}</p>
                )}
              </div>

              {exp.certificateLink && (
                <div class="pt-4">
                  <a 
                    href={exp.certificateLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0f172a] hover:bg-black text-white text-xs font-black uppercase tracking-widest transition-all duration-300 shadow-md"
                  >
                    View Certificate
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                </div>
              )}
            </div>

            {exp.image && (
              <div class="w-full space-y-4">
                {Array.isArray(exp.image) ? (
                  exp.image.slice(0, 2).map((imgUrl) => (
                    <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-1 shadow-sm">
                      <img src={imgUrl} alt={exp.company} class="object-cover rounded-xl w-full h-auto" />
                    </div>
                  ))
                ) : (
                  <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-1 shadow-sm">
                    <img src={exp.image} alt={exp.company} class="object-cover rounded-xl w-full h-auto" />
                  </div>
                )}
              </div>
            )}
          </div>

        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupExperienceNavigation = () => {
    const grid = document.getElementById('experience-grid');
    const viewBtns = document.querySelectorAll('.view-exp-details-btn');
    const backBtns = document.querySelectorAll('.back-to-exp-grid');

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-experience-target');
        const targetView = document.getElementById(`exp-detail-${targetId}`);

        grid?.classList.add('-translate-x-12', 'opacity-0', 'pointer-events-none');
        
        setTimeout(() => {
          grid?.classList.add('hidden');
          targetView?.classList.remove('hidden');
          requestAnimationFrame(() => {
            targetView?.classList.remove('opacity-0', 'translate-x-12');
            targetView?.classList.add('opacity-100', 'translate-x-0');
            targetView?.classList.remove('absolute');
            targetView?.classList.add('relative');
          });
        }, 400);

        const section = document.getElementById('experience');
        section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    backBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const currentView = btn.closest('.experience-detail-view');
        currentView?.classList.add('opacity-0', 'translate-x-12');
        currentView?.classList.remove('relative');
        currentView?.classList.add('absolute');

        setTimeout(() => {
          currentView?.classList.add('hidden');
          grid?.classList.remove('hidden');
          requestAnimationFrame(() => {
            grid?.classList.remove('-translate-x-12', 'opacity-0', 'pointer-events-none');
            grid?.classList.add('translate-x-0');
          });
        }, 400);
      });
    });
  };

  setupExperienceNavigation();
  document.addEventListener('astro:after-navigation', setupExperienceNavigation);
</script>