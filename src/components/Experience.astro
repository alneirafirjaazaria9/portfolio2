---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
    {/*Sidebar Section */}
    <div class="flex flex-row lg:flex-col overflow-x-auto lg:overflow-visible w-full lg:w-64 flex-shrink-0 gap-2 border-b lg:border-b-0 lg:border-l border-white/10 pb-4 lg:pb-0 scrollbar-hide">
      {experience.map(({ company, position }, index) => (
        <button
          class={`exp-tab-btn px-4 py-3 text-left transition-all duration-300 border-b-2 lg:border-b-0 lg:border-l-2 whitespace-nowrap lg:whitespace-normal font-medium ${
            index === 0 ? "text-primary border-primary bg-primary/10" : "text-white/50 border-transparent hover:bg-white/5 hover:text-white"
          }`}
          data-index={index}
        >
          {company}
          <span class="block text-xs opacity-70 mt-1 font-normal truncate">{position}</span>
        </button>
      ))}
    </div>

    {/* Content Panels */}
    <div class="flex-1 w-full min-h-[400px]">
      {experience.map(({ company, position, logo, location, startDate, endDate, summary, image, certificateLink }, index) => (
        <div 
          id={`exp-panel-${index}`} 
          class={`exp-panel transition-opacity duration-300 ${index === 0 ? "block opacity-100" : "hidden opacity-0"}`}
        >
          <div class="flex flex-col md:flex-row gap-8 lg:gap-12 items-start">
            <div class="flex-1">
              <h3 class="mb-1.5 font-serif text-3xl font-bold text-white">
                {position}
              </h3>

              <div class="flex items-center gap-3 mb-4 mt-2">
                {logo && (
                  <div class="w-10 h-10 flex-shrink-0 rounded-full overflow-hidden border border-white/20 bg-white/5 flex items-center justify-center">
                    <img src={logo} alt={`Logo ${company}`} class="w-full h-full object-cover bg-white" />
                  </div>
                )}
                <h4 class="text-xl font-semibold text-primary mb-0">
                  {company}
                </h4>
              </div>
              
              {/* Certificated Area */}
              <div class="flex flex-wrap gap-3 mb-6">
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 text-xs text-white/70 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {location}
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 text-xs text-white/70 font-medium">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                  {startDate} — {endDate}
                </div>
              </div>
              
              {/* Summary Section */}
              {Array.isArray(summary) ? (
                <ul class="list-none mb-6">
                  {summary.map((log) => (
                    <li class="relative mb-3 pl-8 text-base text-neutral text-justify before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                      {log}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-base text-neutral text-justify mb-6">{summary}</p>
              )}

              {/* Certificate Button */}
              {certificateLink && (
                <div class="mt-4">
                  <a 
                    href={certificateLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 w-full rounded-xl border border-white/10 bg-white/5 text-sm font-bold text-white transition-all duration-300 hover:bg-white/10 hover:border-primary/40 hover:scale-[1.01] hover:shadow-lg"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    View Certificate
                  </a>
                </div>
              )}
            </div>

            {/* Documentation Section */}
            {image && (
              <div class="w-full md:w-80 flex-shrink-0">
                <div class="flex flex-col gap-4">
                  {Array.isArray(image) ? (
                    image.slice(0, 2).map((imgUrl) => (
                      <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-white/5">
                        <img src={imgUrl} alt={company} class="object-cover w-full h-auto transition-transform duration-500 hover:scale-105" />
                      </div>
                    ))
                  ) : (
                    <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-white/5">
                      <img src={image} alt={company} class="object-cover w-full h-auto transition-transform duration-500 hover:scale-105" />
                    </div>
                  )}
                </div>
              </div>
            )}
            
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>

<script>
  {/* Script JS tetap sama untuk fungsionalitas tab */}
  const buttons = document.querySelectorAll('.exp-tab-btn');
  const panels = document.querySelectorAll('.exp-panel');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetIndex = btn.getAttribute('data-index');

      buttons.forEach(b => {
        b.classList.remove('text-primary', 'border-primary', 'bg-primary/10');
        b.classList.add('text-white/50', 'border-transparent');
      });
      
      btn.classList.add('text-primary', 'border-primary', 'bg-primary/10');
      btn.classList.remove('text-white/50', 'border-transparent');

      panels.forEach((panel, idx) => {
        if (idx.toString() === targetIndex) {
          panel.classList.remove('hidden');
          setTimeout(() => panel.classList.add('opacity-100'), 10);
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('opacity-100');
        }
      });
    });
  });
</script>