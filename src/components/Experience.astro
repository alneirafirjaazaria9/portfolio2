---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  {
    experience.map(({ company, position, startDate, endDate, summary, image }) => (
      <div class="mb-14 flex flex-col md:flex-row gap-12 items-start">
        <div class="flex-1">
          <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white">
            {company}
          </h3>
          <div class="flex flex-col items-start pb-4">
            <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
              {position}
            </h4>
            <span class="text-sm text-white/70">
              {startDate} — {endDate}
            </span>
          </div>
          
          {Array.isArray(summary) ? (
            <ul class="list-none">
              {summary.map((log) => (
                /* Menambahkan text-justify di sini */
                <li class="relative mb-3 pl-8 text-base text-neutral text-justify before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                  {log}
                </li>
              ))}
            </ul>
          ) : (
            /* Menambahkan text-justify di sini juga */
            <p class="text-base text-neutral text-justify">{summary}</p>
          )}
        </div>

        {image && (
          <div class="w-full md:w-80 flex-shrink-0">
            <div class="flex flex-col gap-4">
              {Array.isArray(image) ? (
                image.map((imgUrl) => (
                  <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl group">
                    <img 
                      src={imgUrl} 
                      alt={`Documentation at ${company}`} 
                      class="object-cover w-full h-48 transition-transform duration-500 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                  </div>
                ))
              ) : (
                <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-2xl group">
                  <img 
                    src={image} 
                    alt={`Documentation at ${company}`} 
                    class="object-cover w-full h-auto transition-transform duration-500 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    ))
  }
</Section>