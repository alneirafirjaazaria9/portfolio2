---
interface Props {
  siteLogo: string;
  navLinks: { text: string; href: string }[];
}

const { siteLogo, navLinks } = Astro.props;
---

<header class="fixed top-0 left-0 z-50 w-full border-b border-white/10 bg-slate-900/80 backdrop-blur-md px-6 py-4">
  <div class="mx-auto flex max-w-5xl items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img 
        src={siteLogo} 
        alt="Logo" 
        class="h-10 w-10 rounded-full border-2 border-primary object-cover"
      />
      <span class="hidden font-gabarito text-lg font-bold text-white sm:block">
        Alneira
      </span>
    </a>

    <nav>
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-300">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="transition-colors hover:text-white"
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<div class="h-20"></div>