---
interface Props {
  siteLogo: string;
  navLinks: { text: string; href: string }[];
}

const { siteLogo, navLinks } = Astro.props;
---

<header class="fixed top-0 left-0 z-50 w-full border-b border-white/5 bg-black/80 backdrop-blur-md px-4 md:px-8 lg:px-12 py-4">
  <div class="mx-auto flex max-w-full items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src={siteLogo} 
        alt="Logo" 
        class="h-10 w-10 rounded-full border-2 border-primary object-cover transition-transform group-hover:scale-110"
      />
      <span class="hidden font-gabarito text-lg font-bold text-white sm:block transition-colors group-hover:text-primary">
        Alneira
      </span>
    </a>

    <nav>
      <ul class="flex items-center gap-6 text-sm font-medium text-neutral-400">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="transition-all duration-300 hover:text-primary"
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<div class="h-20"></div>