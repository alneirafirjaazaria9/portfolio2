---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="pt-24 pb-12 md:pt-32 md:pb-16" id="#hero">
    <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {specialty}
  </p>
  <p class="mb-16 text-base font-normal text-neutral md:text-lg">
    {summary}
  </p>

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
  <a
    class="inline-block rounded-full bg-primary px-10 py-5 text-sm leading-5 font-semibold text-[#fff] transition-transform hover:scale-105"
    href={email} 
    target="_blank"
  >
    Curriculum Vitae
  </a>

  <div class="flex items-center gap-4">
    <a 
      href="https://www.linkedin.com/in/alneirafirjaazaria" 
      target="_blank" 
      class="flex h-12 w-12 items-center justify-center rounded-full border border-primary text-primary transition-all hover:bg-primary hover:text-white"
      title="LinkedIn"
    >
      <span class="text-xs font-bold">In</span>
    </a>
    
    <a 
      href="https://github.com/alneirafirjaazaria9/" 
      target="_blank" 
      class="flex h-12 w-12 items-center justify-center rounded-full border border-primary text-primary transition-all hover:bg-primary hover:text-white"
      title="GitHub"
    >
      <span class="text-xs font-bold">Git</span>
    </a>

    <a 
      href="https://instagram.com/alneiraa_" 
      target="_blank" 
      class="flex h-12 w-12 items-center justify-center rounded-full border border-primary text-primary transition-all hover:bg-primary hover:text-white"
      title="GitHub"
    >
      <span class="text-xs font-bold">Ins</span>
    </a>
  </div>
</div>
  </div>
</div>
</section>
