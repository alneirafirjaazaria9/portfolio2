---
interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
}

const { name, summary } = Astro.props;
---

<section class="flex flex-col-reverse items-center justify-between gap-6 lg:gap-8 pt-8 pb-6 lg:flex-row min-h-0">
  <!-- KIRI: TEXT & BIO -->
  <div class="flex-1 flex flex-col justify-center text-center lg:text-left">
    <p class="mb-3 text-neutral-400 font-bold tracking-[0.4em] uppercase text-[9px] block">
      Welcome to My Portfolio!
    </p>
    
    <h1 class="mb-4 text-4xl font-black leading-[1.0] text-neutral-900 lg:text-[5.2rem] tracking-tight">
      {name}
    </h1>
    
    <!-- SUMMARY DIPANJANGIN MELEBAR KE KANAN -->
    <p class="mb-8 w-full text-sm md:text-base leading-relaxed text-neutral-600 text-justify font-medium opacity-90 pr-0 lg:pr-2">
      {summary}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
      <a 
        href="/CV_AlneiraFirjaAzaria.pdf" 
        target="_blank" 
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold uppercase tracking-[0.2em] rounded-sm transition-colors duration-300 border border-neutral-900"
      >
        Curriculum Vitae
      </a>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-center">
        <a 
          href="https://linkedin.com/in/alneirafirjaazaria" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a 
          href="https://github.com/alneirafirjaazaria9" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        
        <a 
          href="https://instagram.com/alneiraa_" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="Instagram"
        >
          <i class="fa-brands fa-instagram text-[18px]"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center lg:w-auto">
    <div class="w-full max-w-[340px] bg-white border border-neutral-200/80 rounded-2xl p-4 shadow-sm flex flex-col items-center">
      
      <div class="w-full aspect-[3/4] overflow-hidden rounded-xl bg-neutral-100 border border-neutral-200/60">
        <img 
          src="/aal.png" 
          alt={name} 
          class="w-full h-full object-cover object-top block" 
        />
      </div>

      <div class="w-full mt-3 py-3.5 px-4 bg-neutral-900 border border-neutral-900 rounded-sm text-center flex items-center justify-center">
        <span class="text-white text-[11px] font-bold uppercase tracking-[0.2em] leading-none">
          External Auditor & Accounting
        </span>
      </div>

    </div>
  </div>
</section>