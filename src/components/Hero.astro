---
interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
}

const { name, specialty, summary, email } = Astro.props;
---

<section class="flex flex-col-reverse items-center justify-between gap-8 py-12 lg:flex-row min-h-[70vh]">
  <div class="flex-1 text-center lg:text-left">
    <p class="mb-3 text-neutral-400 font-black tracking-[0.3em] uppercase text-[9px]">
      // Welcome to my portfolio
    </p>
    
    <h1 class="mb-4 text-5xl font-black leading-[0.9] text-neutral-900 lg:text-[6.5rem] tracking-tightest">
      {name}
    </h1>
    
    <h2 class="mb-5 text-lg md:text-xl font-bold text-neutral-500 tracking-tight">
      {specialty}
    </h2>
    
    <p class="mb-10 w-full text-sm md:text-base leading-relaxed text-neutral-600 text-justify lg:max-w-4.5xl lg:pr-12 font-medium opacity-90">
      {summary}
    </p>

    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 mt-6">
      <a 
        href="/CV_AlneiraFirjaAzaria.pdf" 
        target="_blank" 
        class="inline-flex items-center justify-center px-8 py-4 bg-[#0f172a] hover:bg-black text-white text-xs font-black uppercase tracking-widest rounded-full transition-all duration-300 shadow-lg shadow-neutral-900/10"
      >
        Curriculum Vitae
      </a>

      <div class="flex items-center gap-3">
        <a 
          href="https://linkedin.com/in/alneirafirjaazaria" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-700 hover:text-black hover:border-black hover:shadow-md transition-all duration-300"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a 
          href="https://github.com/alneirafirjaazaria9" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-12 h-12 flex items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-700 hover:text-black hover:border-black hover:shadow-md transition-all duration-300"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="w-full lg:w-auto">
    <div class="mx-auto w-full max-w-[360px] rounded-[2.5rem] border border-neutral-200 bg-white p-6 lg:mr-0 shadow-xl shadow-neutral-200/30">
      
      <div class="mx-auto h-64 w-64 overflow-hidden rounded-full border border-neutral-100 p-2 lg:h-72 lg:w-72 shadow-inner bg-neutral-50">
        <div class="h-full w-full rounded-full overflow-hidden border border-neutral-200 bg-white">
           <img 
            src="/aal.png" 
            alt={name} 
            class="w-full h-full object-cover object-top"
           />
        </div>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-neutral-100 bg-[#fafafa] p-4 text-center transition-all hover:border-black/10">
          <p class="text-2xl font-black text-neutral-900 tracking-tighter">4+</p>
          <p class="text-[8px] font-black uppercase tracking-widest text-neutral-400 mt-0.5">Work Exp</p>
        </div>
        <div class="rounded-2xl border border-neutral-100 bg-[#fafafa] p-4 text-center transition-all hover:border-black/10">
          <p class="text-2xl font-black text-neutral-900 tracking-tighter">5+</p>
          <p class="text-[8px] font-black uppercase tracking-widest text-neutral-400 mt-0.5">Key Skills</p>
        </div>
      </div>
    </div>
  </div>
</section>