---
interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
}

const { name, specialty, summary, email } = Astro.props;
---

<section class="flex flex-col-reverse items-center justify-between gap-12 py-16 lg:flex-row min-h-[75vh]">
  <div class="flex-1 flex flex-col justify-center text-center lg:text-left">
    <p class="mb-4 text-neutral-400 font-bold tracking-[0.4em] uppercase text-[9px] block">
      Welcome to My Portfolio!
    </p>
    
    <h1 class="mb-4 text-4xl font-black leading-[1.0] text-neutral-900 lg:text-[5.5rem] tracking-tight">
      {name}
    </h1>
    
    <div class="mb-6 self-center lg:self-start">
      <h2 class="text-base md:text-lg font-serif bold text-neutral-700 tracking-wide font-medium">
        {specialty}
      </h2>
    </div>
    
    <p class="mb-10 w-full text-sm md:text-base leading-relaxed text-neutral-600 text-justify lg:max-w-4xl font-medium opacity-90">
      {summary}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
      <a 
        href="/CV_AlneiraFirjaAzaria.pdf" 
        target="_blank" 
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold uppercase tracking-[0.2em] rounded-sm transition-colors duration-300 border border-neutral-900"
      >
        Curriculum Vitae
      </a>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-center">
        
        <a 
          href="https://linkedin.com/in/alneirafirjaazaria" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a 
          href="https://github.com/alneirafirjaazaria9" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        
        <a 
          href="https://instagram.com/alneiraa_" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-11 h-11 flex items-center justify-center rounded-sm bg-neutral-900 border border-neutral-900 text-white hover:bg-neutral-800 hover:border-neutral-800 transition-all duration-300"
          aria-label="Instagram"
        >
          <i class="fa-brands fa-instagram text-[18px]"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center lg:w-auto">
    <div class="relative p-2.5">
      
      <div class="absolute top-0 left-0 w-8 h-8 border-t-[3px] border-l-[3px] border-neutral-950 z-10"></div>
      
      <div class="absolute top-0 right-0 w-8 h-8 border-t-[3px] border-r-[3px] border-neutral-950 z-10"></div>
      
      <div class="absolute bottom-0 right-0 w-8 h-8 border-b-[3px] border-r-[3px] border-neutral-950 z-10"></div>
      
      <div class="absolute bottom-0 left-0 w-8 h-8 border-b-[3px] border-l-[3px] border-neutral-950 z-10"></div>

      <div class="w-full max-w-[340px] rounded-sm border border-neutral-200 bg-white p-5 shadow-sm relative">
        
        <div class="w-full aspect-square overflow-hidden rounded-sm border border-neutral-100 p-1 bg-neutral-50">
          <div class="h-full w-full rounded-sm overflow-hidden border border-neutral-200 bg-white">
            <img 
              src="/aal.png" 
              alt={name} 
              class="w-full h-full object-cover object-top block" 
            />
          </div>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2">
          <div class="rounded-sm border border-neutral-100 bg-[#fbfbfb] py-3 px-4 text-center">
            <p class="text-xl font-black text-neutral-900 tracking-tight">4+</p>
            <p class="text-[9px] font-bold uppercase tracking-[0.15em] text-neutral-400 mt-0.5">Work Experiences</p>
          </div>
          <div class="rounded-sm border border-neutral-100 bg-[#fbfbfb] py-3 px-4 text-center">
            <p class="text-xl font-black text-neutral-900 tracking-tight">5+</p>
            <p class="text-[9px] font-bold uppercase tracking-[0.15em] text-neutral-400 mt-0.5">Technical Skills</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>