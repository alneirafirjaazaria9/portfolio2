---
interface Props {
  name: string;
  specialty: string;
  summary: string;
  email: string;
}

const { name, specialty, summary, email } = Astro.props;
---

<section class="flex flex-col-reverse items-center justify-between gap-8 py-12 lg:flex-row min-h-[70vh]">
  <div class="flex-1 text-center lg:text-left">
  <p class="mb-3 text-neutral-400 font-black tracking-[0.3em] uppercase text-[9px]">
    // Welcome to my portfolio
  </p>
  
  <h1 class="mb-4 text-5xl font-black leading-[0.9] text-neutral-900 lg:text-[6.5rem] tracking-tightest">
    {name}
  </h1>
  
  <h2 class="mb-5 text-lg md:text-xl font-bold text-neutral-500 tracking-tight">
    {specialty}
  </h2>
  
  {}
  <p class="mb-10 w-full text-sm md:text-base leading-relaxed text-neutral-600 text-justify lg:max-w-4.5xl lg:pr-12 font-medium opacity-90">
    {summary}
  </p>

  <div class="flex flex-col items-center gap-6 lg:items-start">
    <a 
      href="/CV_AlneiraFirjaAzaria.pdf" 
      class="rounded-full bg-black px-10 py-3.5 font-black text-[15px] uppercase tracking-widest text-white transition-all hover:bg-neutral-800 hover:shadow-xl active:scale-95"
    >
      Curriculum Vitae
    </a>
  </div>
</div>

      {}
  <div class="w-full lg:w-auto">
    <div class="mx-auto w-full max-w-[360px] rounded-[2.5rem] border border-neutral-200 bg-white p-6 lg:mr-0 shadow-xl shadow-neutral-200/30">
      
      {}
      <div class="mx-auto h-64 w-64 overflow-hidden rounded-full border border-neutral-100 p-2 lg:h-72 lg:w-72 shadow-inner bg-neutral-50">
        <div class="h-full w-full rounded-full overflow-hidden border border-neutral-200 bg-white">
           <img 
            src="/aal.png" 
            alt={name} 
            class="w-full h-full object-cover object-top"
           />
        </div>
      </div>

      {}
      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-neutral-100 bg-[#fafafa] p-4 text-center transition-all hover:border-black/10">
          <p class="text-2xl font-black text-neutral-900 tracking-tighter">4+</p>
          <p class="text-[8px] font-black uppercase tracking-widest text-neutral-400 mt-0.5">Work Exp</p>
        </div>
        <div class="rounded-2xl border border-neutral-100 bg-[#fafafa] p-4 text-center transition-all hover:border-black/10">
          <p class="text-2xl font-black text-neutral-900 tracking-tighter">5+</p>
          <p class="text-[8px] font-black uppercase tracking-widest text-neutral-400 mt-0.5">Key Skills</p>
        </div>
      </div>
    </div>
  </div>
</section>