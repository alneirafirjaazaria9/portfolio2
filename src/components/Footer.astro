---
// src/components/Contact.astro
---

<section class="py-24 text-center">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="mb-6 text-5xl font-bold tracking-tight text-white md:text-6xl">
      Ready to Bring Value to Your <span class="text-primary italic">Team!</span>
    </h2>
    
    <p class="mb-12 text-lg text-neutral-400">
      Whether it's accounting or auditing, I'm ready to help. Let's start a conversation.
    </p>

    <div class="flex flex-wrap justify-center gap-6 mb-20">
      <a 
        href="https://linkedin.com/in/alneirafirjaazaria" 
        target="_blank"
        class="rounded-xl bg-primary px-10 py-4 font-bold text-white transition-all hover:bg-primary/80 hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(168,28,28,0.2)]"
      >
        LinkedIn
      </a>
      
      <a 
        href="https://instagram.com/alneiraa_" 
        target="_blank"
        class="flex items-center gap-3 rounded-xl border border-primary px-10 py-4 font-bold text-white transition-all hover:bg-primary/10 hover:scale-105 active:scale-95"
      >
        Instagram
      </a>

      <a 
        href="mailto:neirazaa04@gmai.com" 
        class="flex items-center gap-3 rounded-xl bg-primary px-10 py-4 font-bold text-white transition-all hover:bg-primary/80 hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(168,28,28,0.2)]"
      >
        <i class="fa-solid fa-envelope"></i>
        Email Me
      </a>
    </div>

    <div class="border-t border-white/5 pt-10">
      <p class="text-sm text-neutral-500">
        © 2026 Alneira Firja Azaria. All rights reserved. 
      </p>
      <p class="mt-2 text-[12px] italic text-neutral-600">
        Hand-crafted by <span class="text-neutral-400 font-medium">Alneira Firja Azaria</span> — Accounting & Audit Enthusiast
      </p>
    </div>
  </div>
</section>