---
import Section from "./Section.astro";
---

<Section text="Contacts" href="contact">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
    <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-8 backdrop-blur-xl">
      <form action="https://formspree.io/f/mreaobqp" method="POST" class="flex flex-col gap-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <input type="text" name="name" placeholder="Name" required class="bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all" />
          <input type="email" name="email" placeholder="Email" required class="bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all" />
        </div>
        <input type="text" name="subject" placeholder="Subject" class="bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all" />
        <textarea name="message" rows="4" placeholder="Type your message here" class="bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary outline-none transition-all"></textarea>
        <button type="submit" class="bg-primary hover:bg-primary/80 text-white font-bold py-3 rounded-xl transition-all hover:-translate-y-1">
          Send Message
        </button>
      </form>
    </div>

    <div class="flex flex-col gap-8 lg:pl-10">
      <div class="flex items-center gap-6 group">
        <div class="h-14 w-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-primary text-xl group-hover:border-primary/50 transition-all">
          <i class="fa-solid fa-phone"></i>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-neutral-500">Phone</p>
          <p class="text-lg font-medium text-white">+62 882 3584 3754</p>
        </div>
      </div>
      
      <div class="flex items-center gap-6 group">
        <div class="h-14 w-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-primary text-xl group-hover:border-primary/50 transition-all">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-neutral-500">Email</p>
          <p class="text-lg font-medium text-white">neirazaa04@gmail.com</p>
        </div>
      </div>
    </div>
  </div>
</Section>