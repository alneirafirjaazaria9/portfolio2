---
import Section from "./Section.astro";
import type { CertificationProps } from "@types";

interface Props {
  certification: CertificationProps[];
}

const { certification } = Astro.props;
---

<Section text="Certification" href="certification">
  <div class="max-h-[700px] overflow-y-auto pr-2 custom-scroll-area space-y-8">
    {
      certification.map(({ title, issuer, date, summary, image, linkSource }) => (
        
        <div class="group relative overflow-hidden rounded-[2rem] border border-neutral-200 bg-white transition-all duration-500 hover:shadow-xl hover:shadow-neutral-200/50">
          <div class="flex flex-col md:flex-row items-stretch min-h-[300px]">
            
            {}
            <div class="flex-[1.5] p-8 md:p-12 flex flex-col justify-center relative z-10">
              
              <div class="flex flex-wrap items-center gap-4 mb-6">
            {}
                <span class="px-3 py-1 rounded-lg bg-neutral-100 border border-neutral-200 text-[11px] font-bold text-neutral-600 uppercase tracking-widest">
                  {issuer}
                </span>
                <span class="px-3 py-1 rounded-lg bg-neutral-100 border border-neutral-200 text-[11px] font-bold text-neutral-600 uppercase tracking-widest">
                 {date}
                </span>
              </div>

            {}
              <h3 class="text-2xl md:text-4xl font-black text-neutral-900 tracking-tighter leading-[1.1] mb-5 transition-colors duration-300">
                {title}
              </h3>
              
              <p class="text-sm md:text-base text-neutral-500 leading-relaxed max-w-lg font-medium opacity-90">
                "{summary}"
              </p>
              
              {linkSource && (
                <div class="mt-8">
                  <a 
                    href={linkSource} 
                    target="_blank" 
                    class="inline-flex items-center gap-3 text-[12px] font-black text-neutral-900 uppercase tracking-[0.3em] group/link border-b border-black/10 pb-1 hover:border-black transition-all"
                  >
                    View Credential 
                    <span class="transform transition-transform group-hover/link:translate-x-2">→</span>
                  </a>
                </div>
              )}
            </div>

            {}
            <div class="flex-1 relative min-h-[250px] md:min-h-full overflow-hidden border-t md:border-t-0 md:border-l border-neutral-100">
              <img 
                src={image} 
                alt={title} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" 
              />
            {}
              <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-l from-transparent via-white/5 to-white pointer-events-none"></div>
            </div>

          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  
  .custom-scroll-area::-webkit-scrollbar { width: 4px; }
  .custom-scroll-area::-webkit-scrollbar-track { background: transparent; }
  .custom-scroll-area::-webkit-scrollbar-thumb { 
    background: #e5e7eb; 
    border-radius: 10px; 
  }
  .custom-scroll-area:hover::-webkit-scrollbar-thumb { 
    background: #d1d5db; 
  }
</style>