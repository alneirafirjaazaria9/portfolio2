---
interface Props {
  text: string;
  href: string;
}
const { text, href } = Astro.props;
---
<section 
  id={href} 
  class="py-10 my-6 border border-neutral-200 bg-white rounded-[2rem] px-8 md:px-12 shadow-sm shadow-neutral-100/50"
>
  <h2 class="mb-8 font-black text-3xl md:text-5xl tracking-tightest text-neutral-900">
    {text}
  </h2>
  <slot />
</section>