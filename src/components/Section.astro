---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="py-16 my-8 border border-white/10 bg-white/5 rounded-3xl px-8 md:px-12 shadow-sm">
  <h2
    class="mb-14 font-montserrat text-4xl font-bold tracking-tighter text-white md:text-5xl"
  >
    {text}
  </h2>
  <slot />
</section>