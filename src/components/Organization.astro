---
import Section from "./Section.astro";
import type { OrganizationProps } from "@types";

interface Props {
  organization: OrganizationProps[];
}

const { organization } = Astro.props;
---

<Section text="Organization" href="organization">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {organization.map((item) => (
      <div class="group flex flex-col rounded-2xl border border-white/5 bg-neutral-900/50 p-8 transition-all duration-300 hover:border-primary/40 hover:bg-neutral-900">
        
        <div class="mb-6">
          <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors leading-tight mb-2">
            {item.role}
          </h3>
          <p class="text-sm font-semibold text-primary/80 uppercase tracking-wider">
            {item.organization}
          </p>
          <p class="text-[11px] text-neutral-500 font-medium tracking-widest mt-1">
            {item.date}
          </p>
        </div>

        <p class="text-neutral-400 text-sm leading-relaxed flex-grow">
          {item.description}
        </p>
              </div>
    ))}
  </div>
</Section>