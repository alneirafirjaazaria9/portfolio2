---
import Section from "./Section.astro";
import type { OrganizationProps } from "@types";

interface Props {
  organization: OrganizationProps[];
}

const { organization } = Astro.props;
---

<Section text="Organization" href="organization">
  <div class="space-y-2">
    {organization.map(({ role, organization: orgName, date, description, certificateLink, photos }) => (
      <div class="org-item group border-b border-neutral-100 last:border-0">
        {/* TRIGGER: Clickable Area */}
        <button class="org-trigger w-full py-8 flex flex-col md:flex-row md:items-baseline justify-between gap-4 cursor-pointer group/btn">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
               <span class="h-px w-0 bg-black transition-all duration-500 group-hover/btn:w-6 hidden md:block"></span>
               <h3 class="text-xl md:text-2xl font-black text-neutral-900 tracking-tight group-hover/btn:translate-x-1 transition-transform duration-500">
                {role}
              </h3>
            </div>
            <div class="flex items-center gap-3 text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-400">
              <span class="text-neutral-900">{orgName}</span>
              <span class="h-1 w-1 rounded-full bg-neutral-200"></span>
              <span>{date}</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-[9px] font-black uppercase tracking-[0.2em] opacity-0 group-hover/btn:opacity-100 transition-all duration-500 translate-x-2 group-hover/btn:translate-x-0">
              Details
            </span>
            <div class="w-8 h-8 rounded-full border border-neutral-100 flex items-center justify-center group-hover/btn:border-black transition-colors duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon transition-transform duration-500">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </div>
          </div>
        </button>

        {/* EXPANDABLE CONTENT */}
        <div class="org-content max-h-0 overflow-hidden transition-all duration-700 ease-in-out">
          <div class="pb-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            {/* Kiri: Narrative & Action */}
            <div class="lg:col-span-7">
              <p class="text-neutral-500 text-sm md:text-base leading-relaxed mb-8 font-medium">
                {description}
              </p>
              
              {certificateLink && (
              <div class="mt-4">
                  <a 
                    href={certificateLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center gap-3 px-8 py-3 w-full md:w-auto rounded-xl border-2 border-black bg-black text-sm font-black text-white transition-all duration-300 hover:bg-transparent hover:text-black hover:shadow-lg active:scale-95"
                  >
                    View Certificate
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                </div>
              )}
              </div>

            {/* Kanan: Documentation Gallery */}
            <div class="lg:col-span-5">
              {photos && photos.length > 0 && (
                <div class="grid grid-cols-2 gap-2">
                  {photos.slice(0, 4).map((imgUrl) => (
                    <div class="aspect-[4/3] rounded-lg overflow-hidden border border-neutral-100 bg-neutral-50">
                      <img src={imgUrl} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupOrgAccordion = () => {
    const items = document.querySelectorAll('.org-item');
    
    items.forEach(item => {
      const trigger = item.querySelector('.org-trigger');
      const content = item.querySelector('.org-content') as HTMLElement;
      const icon = item.querySelector('.chevron-icon');

      trigger?.addEventListener('click', () => {
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
        
        // Reset all others (Accordion mode)
        document.querySelectorAll('.org-content').forEach(c => (c as HTMLElement).style.maxHeight = '0px');
        document.querySelectorAll('.chevron-icon').forEach(i => i.classList.remove('rotate-180'));

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
          icon?.classList.add('rotate-180');
        }
      });
    });
  };

  setupOrgAccordion();
  document.addEventListener('astro:after-navigation', setupOrgAccordion);
</script>