---
import Section from "./Section.astro";
import type { OrganizationProps } from "@types";

interface Props {
  organization: OrganizationProps[];
}

const { organization } = Astro.props;
---

<Section text="Organization" href="organization">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6"> { /* Ini yang bikin berjajar 2-2 */ }
    {
      organization.map(({ role, organization, date, description }) => (
        <div class="p-6 border border-white/10 bg-white/5 rounded-2xl flex flex-col hover:border-primary/30 transition-all group">
          <span class="text-xs font-mono text-primary mb-2">{date}</span>
          <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
            {role}
          </h3>
          <p class="text-sm text-white/50 mb-4">{organization}</p>
          <p class="text-base text-neutral line-clamp-3">
            {description}
          </p>
        </div>
      ))
    }
  </div>
</Section>