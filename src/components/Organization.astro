---
import Section from "./Section.astro";
import type { OrganizationProps } from "@types";

interface Props {
  organization: OrganizationProps[];
}

const { organization } = Astro.props;
---

<Section text="Organization" href="organization">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {organization.map(({ role, organization: orgName, date, description, certificateLink }) => (
      <div class="group flex flex-col justify-start rounded-2xl border border-white/10 bg-[#161616]/50 p-6 md:p-8 transition-colors duration-300 hover:border-primary/50">
        
        {/* Bagian Header: Judul Jabatan & Tombol Link */}
        <div class="flex justify-between items-start gap-4 mb-1">
          <h3 class="text-xl font-bold text-white leading-tight">
            {role}
          </h3>
          
          {/* Tombol Bulat Sertifikat */}
          {certificateLink && (
            <a 
              href={certificateLink} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full border border-white/10 bg-white/5 text-white/50 hover:bg-white/10 hover:text-white transition-all duration-300"
              title="View Certificate"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          )}
        </div>

        <h4 class="font-semibold text-primary uppercase text-sm tracking-wide mb-1">
          {orgName}
        </h4>
        
        <p class="text-xs font-medium text-white/40 mb-4">
          {date}
        </p>
        
        <p class="text-sm text-neutral text-justify leading-relaxed">
          {description}
        </p>

      </div>
    ))}
  </div>
</Section>