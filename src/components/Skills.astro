---
interface Props {
  skills: {
    technical: { name: string; level: string }[];
    soft: { name: string; level: string }[];
  };
}

const { skills } = Astro.props;

const getBarWidth = (level: string) => {
  const normalizedLevel = level.toLowerCase();
  if (normalizedLevel.includes('intermediate')) {
    return 'w-[70%]';
  }
  return 'w-full'; // Expert, Certified, Experienced, dll -> 100%
};
---

<section id="skills" class="py-12 border border-neutral-200 bg-white rounded-[2.5rem] px-8 md:px-16 shadow-sm shadow-neutral-100/50">
  <div class="mb-14">
    <h2 class="text-4xl md:text-6xl font-black tracking-tightest text-neutral-900 leading-none">
      Skills
    </h2>
    <p class="text-neutral-500 mt-5 text-sm md:text-base font-medium max-w-6xl">
      Technical expertise and interpersonal strengths developed through academic rigor and professional experience.
    </p>
  </div>

  {/* SPLIT VIEW: 2 Kolom Utama */}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
    
    {/* SISI KIRI: SOFT SKILLS */}
    <div class="space-y-6">
      <h3 class="text-[13px] font-black text-black uppercase tracking-[0.4em] flex items-center gap-3">
        <span class="h-[1.5px] w-8 bg-black"></span> Soft Skills
      </h3>
      <div class="space-y-5">
        {skills.soft.map((skill) => (
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <span class="text-sm font-bold text-neutral-800 tracking-tight">{skill.name}</span>
              <span class="text-[10px] font-black uppercase tracking-widest text-neutral-400">{skill.level}</span>
            </div>
            <div class="w-full bg-neutral-100 h-2 rounded-full overflow-hidden">
              <div class={`bg-neutral-900 h-2 rounded-full transition-all duration-500 ${getBarWidth(skill.level)}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* SISI KANAN: TECHNICAL SKILLS */}
    <div class="space-y-6">
      <h3 class="text-[13px] font-black text-black uppercase tracking-[0.4em] flex items-center gap-3">
        <span class="h-[1.5px] w-8 bg-black"></span> Technical Skills
      </h3>
      <div class="space-y-5">
        {skills.technical.map((skill) => (
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <span class="text-sm font-bold text-neutral-800 tracking-tight">{skill.name}</span>
              <span class="text-[10px] font-black uppercase tracking-widest text-neutral-400">{skill.level}</span>
            </div>
            <div class="w-full bg-neutral-100 h-2 rounded-full overflow-hidden">
              <div class={`bg-neutral-900 h-2 rounded-full transition-all duration-500 ${getBarWidth(skill.level)}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>