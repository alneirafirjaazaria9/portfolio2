---
interface Props {
  skills: {
    technical: { name: string; level: string }[];
    soft: { name: string; level: string }[];
  };
}

const { skills } = Astro.props;
---

<section id="skills" class="pt-10 pb-0">
  <div class="mb-6">
    <h2 class="text-4xl font-bold text-white">Skills</h2>
    <p class="text-slate-400 mt-2">Technical expertise and interpersonal strengths.</p>
  </div>

  <div class="rounded-3xl border border-white/10 bg-slate-800/30 p-8 backdrop-blur-sm space-y-10">
    
    <div>
      <h3 class="text-xl font-semibold text-primary mb-5 flex items-center gap-2">
        <span class="h-px w-8 bg-primary"></span> Technical Skills
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {skills.technical.map((skill) => (
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-slate-900/50 p-5 transition-all hover:border-primary/50">
            <div class="absolute left-0 top-0 h-full w-1 bg-primary opacity-0 transition-opacity group-hover:opacity-100"></div>
            <h4 class="font-bold text-white group-hover:text-primary transition-colors">{skill.name}</h4>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider">{skill.level}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-xl font-semibold text-primary mb-5 flex items-center gap-2">
        <span class="h-px w-8 bg-primary"></span> Soft Skills
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {skills.soft.map((skill) => (
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-slate-900/50 p-5 transition-all hover:border-primary/50">
            <div class="absolute left-0 top-0 h-full w-1 bg-primary opacity-0 transition-opacity group-hover:opacity-100"></div>
            <h4 class="font-bold text-white group-hover:text-primary transition-colors">{skill.name}</h4>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider">{skill.level}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>