---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div id="projects-main-container" class="relative overflow-hidden min-h-[500px]">
    
    {/* 1. GRID VIEW */}
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]">
      {projects.map((project, index) => (
        <div class="group flex flex-col rounded-[2rem] border border-neutral-200 bg-white overflow-hidden transition-all duration-500 hover:shadow-xl hover:shadow-neutral-200/40">
          <div class="relative w-full aspect-video overflow-hidden bg-neutral-100">
            <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} width={600} height={338} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            />
          </div>
          
          <div class="p-6 md:p-8 flex flex-col flex-grow text-left">
            <h3 class="text-xl md:text-2xl font-black text-neutral-900 mb-2 tracking-tightest">{project.name}</h3>
            <p class="text-xs md:text-sm text-neutral-500 line-clamp-2 mb-6 leading-relaxed font-medium">
              {project.summary}
            </p>
            
            <div class="mt-auto pt-4 border-t border-neutral-100">
              <button 
                type="button"
                data-project-target={index}
                class="view-details-btn w-full text-[9px] font-black text-neutral-900 uppercase tracking-[0.3em] hover:opacity-60 transition-all flex items-center justify-between cursor-pointer group/btn"
              >
                <span>View Details</span>
                <span class="text-lg transform transition-transform duration-300 group-hover/btn:translate-x-1">→</span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* 2. DETAIL VIEW */}
    {projects.map((project, index) => (
      <div 
        id={`detail-${index}`} 
        class="project-detail-view hidden absolute top-0 left-0 w-full opacity-0 translate-x-12 transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)]"
      >
        <button class="back-to-grid mb-6 flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.2em] text-neutral-400 hover:text-black transition-colors group">
          <span class="text-base transition-transform group-hover:-translate-x-1">←</span> Back to Projects
        </button>

        <div class="rounded-[2rem] border border-neutral-200 bg-white overflow-hidden p-5 md:p-10 max-w-7xl mx-auto shadow-sm">
          {/* Header Gambar */}
          <div class="w-full bg-neutral-100 h-[200px] md:h-[350px] rounded-xl overflow-hidden mb-8 border border-neutral-100">
             <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} width={1000} height={500} 
              class="w-full h-full object-cover" 
             />
          </div>

          <h2 class="text-3xl md:text-5xl font-black mb-4 text-neutral-900 tracking-tightest leading-tight">{project.name}</h2>
          <p class="text-neutral-500 mb-10 text-xs md:text-base text-justify leading-relaxed font-medium max-w-4xl opacity-90">{project.summary}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 border-t border-neutral-100 pt-8 mb-8">
            {/* Key Features */}
            <div class="space-y-4">
              <h4 class="flex items-center gap-3 text-[9px] font-black text-black uppercase tracking-[0.3em]">
                <span class="w-4 h-[1.5px] bg-black"></span> Key Features
              </h4>
              <ul class="space-y-2.5">
                {(project.features || ['Internal Control', 'Automated Reporting']).map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs text-neutral-600 font-bold leading-snug">
                    <svg class="mt-0.5 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            {/* Skills / Tech Stack */}
            <div class="space-y-4">
              <h4 class="flex items-center gap-3 text-[12px] font-black text-black uppercase tracking-[0.3em]">
                <span class="w-4 h-[1.5px] bg-black"></span> {project.name.toLowerCase().includes('excel') ? 'Skills Applied' : 'Tech Stack'}
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {(project.tags || ['Accounting', 'Excel', 'Analysis']).map((tag) => (
                  <span class="px-3 py-1.5 rounded-full bg-neutral-50 border border-neutral-200 text-[8px] text-neutral-500 uppercase font-black tracking-widest hover:bg-white hover:border-black transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {}
          {project.name.toLowerCase().includes('excel') && (
            <div class="mb-10 pt-8 border-t border-neutral-100">
              <h4 class="flex items-center gap-3 text-[9px] font-black text-black uppercase tracking-[0.3em] mb-6">
                <span class="w-4 h-[1.5px] bg-black"></span> Logical Conceptual
              </h4>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {(project.formulas || [
                  { name: 'Status Pencairan Anggaran', code: '=IF(VLOOKUP(Desc)=MonthlyTotal, "Done", "Partial")' },
                  { name: 'Tanggal Jatuh Tempo', code: '=WORKDAY(Tanggal_Selesai, 3)' },
                  { name: 'Realisasi Anggaran', code: '=IF(ISBLANK(Date), "N/A", IF(Date<Due, "OnTime", "Late"))' },
                  { name: 'Variance Analysis', code: '=(Actual_Budget - Budget)' }
                ]).map((f) => (
                  <div class="group p-4 bg-white border border-neutral-200 rounded-xl hover:border-black transition-all duration-300">
                    <p class="text-[10px] text-neutral-400 mb-1.5 uppercase font-black tracking-wider group-hover:text-black transition-colors">{f.name}</p>
                    <code class="text-[12px] font-mono text-neutral-800 break-all leading-relaxed block bg-neutral-50 p-2 rounded-lg border border-neutral-100">
                      {f.code}
                    </code>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* KEY OUTCOMES */}
          <div class="border-t border-neutral-100 pt-8">
            <h4 class="flex items-center gap-3 text-[16px] font-black text-black uppercase tracking-[0.3em] mb-6">
              <span class="w-4 h-[1.5px] bg-black"></span> Key Outcomes
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {project.outcomes?.map((outcome) => (
                <div class="p-4 rounded-xl bg-white border border-neutral-100 flex gap-4 items-center hover:shadow-md transition-all">
                  <span class="text-2xl">{outcome.icon}</span>
                  <div>
                    <span class="text-neutral-900 font-black block text-[11px] tracking-tight uppercase">{outcome.title}</span>
                    <span class="text-neutral-500 text-[10px] font-medium leading-tight">{outcome.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupProjectNavigation = () => {
    const grid = document.getElementById('projects-grid');
    const viewBtns = document.querySelectorAll('.view-details-btn');
    const backBtns = document.querySelectorAll('.back-to-grid');

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-project-target');
        const targetView = document.getElementById(`detail-${targetId}`);

        grid?.classList.add('-translate-x-12', 'opacity-0', 'pointer-events-none');
        
        setTimeout(() => {
          grid?.classList.add('hidden');
          targetView?.classList.remove('hidden');
          requestAnimationFrame(() => {
            targetView?.classList.remove('opacity-0', 'translate-x-12');
            targetView?.classList.add('opacity-100', 'translate-x-0');
            targetView?.classList.remove('absolute');
            targetView?.classList.add('relative');
          });
        }, 400);

        const section = document.getElementById('projects');
        section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    backBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const currentView = btn.closest('.project-detail-view');
        currentView?.classList.add('opacity-0', 'translate-x-12');
        currentView?.classList.remove('relative');
        currentView?.classList.add('absolute');

        setTimeout(() => {
          currentView?.classList.add('hidden');
          grid?.classList.remove('hidden');
          requestAnimationFrame(() => {
            grid?.classList.remove('-translate-x-12', 'opacity-0', 'pointer-events-none');
            grid?.classList.add('translate-x-0');
          });
        }, 400);
      });
    });
  };

  setupProjectNavigation();
  document.addEventListener('astro:after-navigation', setupProjectNavigation);
</script>