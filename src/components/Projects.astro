---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
    {projects.map((project, index) => (
      <div class="group flex flex-col rounded-[2rem] border border-neutral-200 bg-white overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-neutral-200/50 relative">
        
        {/* Card Thumbnail */}
        <div class="relative w-full aspect-video overflow-hidden bg-neutral-100 group/img">
          <Image 
            src={Array.isArray(project.image) ? project.image[0] : project.image} 
            alt={project.name} 
            width={800} 
            height={450} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover/img:scale-105" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-white/40 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-500"></div>
        </div>
        
        <div class="p-8 md:p-10 flex flex-col flex-grow text-left">
          <h3 class="text-2xl md:text-3xl font-black text-neutral-900 mb-3 tracking-tightest group-hover:text-neutral-600 transition-colors duration-300">
            {project.name}
          </h3>
          <p class="text-sm md:text-base text-neutral-500 line-clamp-3 mb-8 leading-relaxed flex-grow font-medium">
            {project.summary}
          </p>
          
          <div class="mt-auto pt-6 border-t border-neutral-100 relative z-20">
            <button 
              type="button"
              data-open-modal={`modal-${index}`}
              class="open-modal-btn w-full text-[10px] md:text-[11px] font-black text-neutral-900 uppercase tracking-[0.4em] hover:opacity-60 transition-all flex items-center justify-between cursor-pointer group/btn"
            >
              <span>View Details</span>
              <span class="text-xl transform transition-transform duration-300 group-hover/btn:translate-x-2">→</span>
            </button>
          </div>
        </div>

        <dialog 
          id={`modal-${index}`} 
          class="project-modal fixed inset-0 z-[9999] bg-white border border-neutral-200 rounded-[2rem] md:rounded-[3rem] shadow-2xl focus:outline-none overflow-hidden w-[95%] max-w-5xl h-fit max-h-[85vh]"
        >
          <div class="flex flex-col h-full max-h-[85vh] overflow-y-auto custom-scrollbar relative">
            
            <div class="sticky top-0 right-0 z-[70] flex justify-end p-5 pointer-events-none">
              <button 
                type="button"
                data-close-modal={`modal-${index}`}
                class="close-modal-btn pointer-events-auto bg-black hover:bg-neutral-800 p-2.5 rounded-full text-white shadow-xl active:scale-90 transition-all border border-white/10"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
            
            <div class="flex flex-col">
              <div class="w-full bg-neutral-100 aspect-video md:aspect-[21/9] overflow-hidden">
                 <Image 
                  src={Array.isArray(project.image) ? project.image[0] : project.image} 
                  alt={project.name} 
                  width={1200} 
                  height={600} 
                  class="w-full h-full object-cover" 
                 />
              </div>

              <div class="p-6 md:p-12">
                <h2 class="text-3xl md:text-5xl font-black mb-4 text-neutral-900 tracking-tightest leading-none">{project.name}</h2>
                <p class="text-neutral-600 mb-10 text-sm md:text-base text-justify leading-relaxed font-medium max-w-4xl opacity-90">{project.summary}</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10 border-y border-neutral-100 py-10">
                  <div class="space-y-6">
                    <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em]">
                      <span class="w-6 h-[2px] bg-black"></span> Key Features
                    </h4>
                    <ul class="space-y-3">
                      {project.features?.map((feature) => (
                        <li class="flex items-start gap-3 text-sm text-neutral-600 font-medium">
                          <span class="text-black mt-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          </span> 
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="space-y-6">
                    <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em]">
                      <span class="w-6 h-[2px] bg-black"></span> Skills Applied
                    </h4>
                    <div class="flex flex-wrap gap-2">
                      {project.tags?.map((tag) => (
                        <span class="px-4 py-1.5 rounded-full bg-neutral-50 border border-neutral-200 text-[9px] text-neutral-600 uppercase font-black tracking-widest">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="mb-10">
                  <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em] mb-8">
                    <span class="w-6 h-[2px] bg-black"></span> Key Outcomes
                  </h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {project.outcomes?.map((outcome) => (
                      <div class="p-6 rounded-2xl bg-neutral-50 border border-neutral-100 flex gap-4 items-center transition-all">
                        <span class="text-3xl">{outcome.icon}</span>
                        <div>
                          <span class="text-neutral-900 font-black block text-sm mb-0.5 tracking-tight">{outcome.title}</span>
                          <span class="text-neutral-500 text-xs font-medium leading-tight">{outcome.desc}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {project.formulas && project.formulas.length > 0 && (
                  <div class="pt-10 border-t border-neutral-100">
                    <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em] mb-8">
                      <span class="w-6 h-[2px] bg-black"></span> Conceptual Logics
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {project.formulas.map((f) => (
                        <div class="p-5 rounded-xl bg-[#fafafa] border border-neutral-200">
                          <p class="text-[9px] font-black text-neutral-400 uppercase tracking-[0.3em] mb-3">
                            {f.name}
                          </p>
                          <div class="bg-white p-3 rounded-lg border border-neutral-200">
                            <code class="text-[10px] text-neutral-800 font-mono block break-all">
                              {f.code}
                            </code>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </dialog>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupModals = () => {
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      
      if (target.closest('.open-modal-btn')) {
        const modalId = target.closest('.open-modal-btn')?.getAttribute('data-open-modal');
        const modal = document.getElementById(modalId!) as HTMLDialogElement;
        if (modal) {
          modal.showModal();
          document.body.style.overflow = 'hidden';
        }
      }

      if (target.closest('.close-modal-btn')) {
        const modal = target.closest('dialog') as HTMLDialogElement;
        if (modal) {
          modal.close();
          document.body.style.overflow = 'auto';
        }
      }

      if (target.nodeName === 'DIALOG' && target.classList.contains('project-modal')) {
        (target as HTMLDialogElement).close();
        document.body.style.overflow = 'auto';
      }
    });
  };

  setupModals();
  document.addEventListener('astro:after-navigation', setupModals);
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f9f9f9; }
  .custom-scrollbar::-webkit-scrollbar-thumb { 
    background: #d4d4d4; 
    border-radius: 20px; 
  }

  dialog::backdrop {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    transition: all 0.5s ease;
  }

  .project-modal {
    display: none;
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  dialog[open] {
    display: block;
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
</style>