---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
    {projects.map((project, index) => (
      <div class="group flex flex-col rounded-3xl border border-white/5 bg-[#111111] overflow-hidden transition-all duration-500 hover:border-primary/40 relative">
        
        {/* Card Thumbnail */}
        <div class="relative w-full aspect-video overflow-hidden border-b border-white/5 bg-neutral-900 group/img">
          <Image 
            src={Array.isArray(project.image) ? project.image[0] : project.image} 
            alt={project.name} 
            width={800} 
            height={450} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover/img:scale-105" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-500"></div>
        </div>
        
        <div class="p-6 md:p-10 flex flex-col flex-grow text-left">
          <h3 class="text-xl md:text-3xl font-extrabold text-white mb-3 tracking-tighter group-hover:text-primary transition-colors duration-300">
            {project.name}
          </h3>
          <p class="text-xs md:text-base text-neutral-400 line-clamp-3 mb-10 leading-relaxed flex-grow font-light">
            {project.summary}
          </p>
          
          <div class="mt-auto pt-6 border-t border-white/5 relative z-20">
            <button 
              type="button"
              data-open-modal={`modal-${index}`}
              class="open-modal-btn w-full text-[11px] md:text-xs font-black text-primary uppercase tracking-[0.3em] hover:text-white transition-all flex items-center justify-between cursor-pointer group/btn"
            >
              <span>View Details</span>
              <span class="text-xl transform transition-transform duration-300 group-hover/btn:translate-x-2">→</span>
            </button>
          </div>
        </div>

        <dialog 
          id={`modal-${index}`} 
          class="project-modal fixed inset-0 z-[9999] bg-[#0a0a0a] border border-white/10 rounded-[2rem] md:rounded-[3rem] shadow-2xl focus:outline-none overflow-hidden w-[95%] max-w-5xl h-fit max-h-[92vh]"
        >
          <div class="flex flex-col h-full max-h-[92vh] overflow-y-auto custom-scrollbar relative">
            
            <div class="sticky top-0 right-0 z-[70] flex justify-end p-5 pointer-events-none">
              <button 
                type="button"
                data-close-modal={`modal-${index}`}
                class="close-modal-btn pointer-events-auto bg-primary/90 hover:bg-primary p-3 rounded-full text-white shadow-2xl active:scale-90 transition-all backdrop-blur-md border border-white/10"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </button>
            </div>
            
            <div class="flex flex-col">
              <div class="w-full bg-neutral-900 aspect-video md:aspect-[21/9] overflow-hidden">
                 <Image 
                  src={Array.isArray(project.image) ? project.image[0] : project.image} 
                  alt={project.name} 
                  width={1200} 
                  height={600} 
                  class="w-full h-full object-cover" 
                 />
              </div>

              <div class="p-8 md:p-14">
                <h2 class="text-3xl md:text-6xl font-black mb-6 text-white tracking-tighter leading-none">{project.name}</h2>
                <p class="text-neutral-400 mb-14 text-sm md:text-lg text-justify leading-relaxed font-light max-w-4xl">{project.summary}</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16 border-y border-white/5 py-12">
                  <div class="space-y-8">
                    <h4 class="flex items-center gap-3 text-[10px] md:text-xs font-black text-primary uppercase tracking-[0.3em]">
                      <span class="w-8 h-[1px] bg-primary"></span> Key Features
                    </h4>
                    <ul class="space-y-5">
                      {project.features?.map((feature) => (
                        <li class="flex items-start gap-4 text-xs md:text-base text-neutral-300 font-light">
                          <span class="text-primary mt-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M21 7L9 19L3.5 13.5L4.91 12.09L9 16.17L19.59 5.58L21 7Z"/></svg>
                          </span> 
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="space-y-8">
                    <h4 class="flex items-center gap-3 text-[10px] md:text-xs font-black text-primary uppercase tracking-[0.3em]">
                      <span class="w-8 h-[1px] bg-primary"></span> Skills Applied
                    </h4>
                    <div class="flex flex-wrap gap-3">
                      {project.tags?.map((tag) => (
                        <span class="px-5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-[10px] md:text-xs text-neutral-300 uppercase font-bold tracking-widest">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="mb-20">
                  <h4 class="flex items-center gap-3 text-[10px] md:text-xs font-black text-primary uppercase tracking-[0.3em] mb-10">
                    <span class="w-8 h-[1px] bg-primary"></span> Key Outcomes
                  </h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {project.outcomes?.map((outcome) => (
                      <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/5 flex gap-5 items-center hover:bg-white/[0.04] transition-all duration-300">
                        <span class="text-4xl">{outcome.icon}</span>
                        <div>
                          <span class="text-white font-black block text-sm md:text-base mb-1 tracking-tight">{outcome.title}</span>
                          <span class="text-neutral-500 text-xs md:text-sm font-light leading-snug">{outcome.desc}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Conceptual Logic Section - Ukuran teks disesuaikan kembali agar compact */}
                {project.formulas && project.formulas.length > 0 && (
                  <div class="pt-12 border-t border-white/5">
                    <h4 class="flex items-center gap-3 text-[10px] md:text-xs font-black text-primary uppercase tracking-[0.3em] mb-10">
                      <span class="w-8 h-[1px] bg-primary"></span> Conceptual Logic
                    </h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {project.formulas.map((f) => (
                        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors group/logic">
                          <p class="text-[9px] font-bold text-primary/80 uppercase tracking-widest mb-3 group-hover/logic:text-primary transition-colors">
                            {f.name}
                          </p>
                          <div class="bg-black/40 p-3 rounded-xl border border-white/5">
                            <code class="text-[11px] md:text-xs text-white/90 font-mono block leading-relaxed break-all">
                              {f.code}
                            </code>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </dialog>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupModals = () => {
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      
      if (target.closest('.open-modal-btn')) {
        const modalId = target.closest('.open-modal-btn')?.getAttribute('data-open-modal');
        const modal = document.getElementById(modalId!) as HTMLDialogElement;
        if (modal) {
          modal.showModal();
          document.body.style.overflow = 'hidden';
          modal.querySelector('.custom-scrollbar')!.scrollTop = 0;
        }
      }

      if (target.closest('.close-modal-btn')) {
        const modal = target.closest('dialog') as HTMLDialogElement;
        if (modal) {
          modal.close();
          document.body.style.overflow = 'auto';
        }
      }

      if (target.nodeName === 'DIALOG' && target.classList.contains('project-modal')) {
        const modal = target as HTMLDialogElement;
        modal.close();
        document.body.style.overflow = 'auto';
      }
    });
  };

  setupModals();
  document.addEventListener('astro:after-navigation', setupModals);
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 8px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { 
    background: #2a2a2a; 
    border-radius: 20px; 
    border: 2px solid #0a0a0a; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #3a3a3a; }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .project-modal {
    display: none;
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  dialog[open] {
    display: block;
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  dialog[open]::backdrop { opacity: 1; }
</style>