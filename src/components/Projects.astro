---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div id="projects-main-container" class="relative overflow-hidden w-full">
    
    <div id="projects-grid" class="w-full flex flex-col gap-6 transition-all duration-500 ease-in-out">
      {projects.map((project, index) => (
        <div class="group flex flex-col sm:flex-row rounded-2xl border border-neutral-200 bg-white overflow-hidden min-h-[110px] transition-all duration-500 hover:shadow-xl hover:shadow-neutral-200/40">
          
          <div class="relative w-full sm:w-1/5 min-w-[100px] sm:min-w-[140px] md:min-w-[160px] h-36 sm:h-auto overflow-hidden bg-neutral-100 flex-shrink-0">
            <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} 
              width={400} 
              height={280} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            />
          </div>
          
          <div class="p-4 sm:p-5 flex flex-col flex-grow text-left justify-between">
            <div>
              <h3 class="text-base sm:text-lg font-black text-neutral-900 mb-1 tracking-tight">{project.name}</h3>
              <p class="text-xs sm:text-sm text-neutral-500 line-clamp-2 md:line-clamp-3 leading-relaxed font-medium">
                {project.summary}
              </p>
            </div>
            
            <div class="pt-3 border-t border-neutral-100/80 mt-3 flex">
              <button 
                type="button"
                data-project-target={index}
                class="view-details-btn inline-flex items-center gap-3 px-4 py-2 rounded-xl border border-neutral-200 bg-white text-[9px] font-black text-neutral-900 uppercase tracking-[0.2em] hover:bg-black hover:text-white hover:border-black transition-all duration-300 cursor-pointer group/btn shadow-sm shadow-neutral-50"
              >
                <span>View Details</span>
                <span class="text-sm leading-none transform transition-transform duration-300 group-hover/btn:translate-x-0.5">→</span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    {projects.map((project, index) => (
      <div 
        id={`detail-${index}`} 
        class="project-detail-view hidden absolute top-0 left-0 w-full opacity-0 translate-x-12 transition-all duration-500 ease-in-out"
      >
        <div class="flex mb-6 w-full">
          <button type="button" class="back-to-grid inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-200 bg-white text-[9px] font-black uppercase tracking-[0.2em] text-neutral-900 hover:bg-black hover:text-white transition-all duration-300 cursor-pointer group shadow-sm shadow-neutral-100">
            <span class="text-sm leading-none transition-transform group-hover:-translate-x-0.5">←</span> Back to Projects
          </button>
        </div>

        <div class="rounded-[2rem] border border-neutral-200 bg-white p-5 md:p-10 w-full shadow-sm">
          <div class="w-full bg-neutral-100 aspect-video max-h-[450px] rounded-2xl overflow-hidden mb-8 border border-neutral-200/60 shadow-sm flex items-center justify-center">
             <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} 
              width={1200} 
              height={675} 
              class="max-w-full max-h-full object-contain" 
             />
          </div>

          <h2 class="text-2xl md:text-4xl font-black mb-4 text-neutral-900 tracking-tight leading-tight">{project.name}</h2>
          <p class="text-neutral-500 mb-8 text-xs md:text-sm text-justify leading-relaxed font-medium max-w-4xl opacity-90">{project.summary}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-neutral-100 pt-8 mb-8">
            <div class="space-y-4">
              <h4 class="flex items-center gap-3 text-[13px] md:text-[14px] font-black text-black uppercase tracking-[0.3em]">
                <span class="w-4 h-[1.5px] bg-black"></span> Key Features
              </h4>
              <ul class="space-y-2.5">
                {(project.features || []).map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs text-neutral-600 font-bold leading-snug">
                    <svg class="mt-0.5 flex-shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <div class="space-y-4">
              <h4 class="flex items-center gap-3 text-[13px] md:text-[14px] font-black text-black uppercase tracking-[0.3em]">
                <span class="w-4 h-[1.5px] bg-black"></span> Skills Applied
              </h4>
              <div class="flex flex-wrap gap-1.5">
                {(project.tags || []).map((tag) => (
                  <span class="px-3 py-1.5 rounded-full bg-neutral-50 border border-neutral-200 text-[11px] text-neutral-500 uppercase font-black tracking-widest hover:bg-white hover:border-black transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {project.formulas && project.formulas.length > 0 && (
            <div class="mb-8 pt-8 border-t border-neutral-100">
              <h4 class="flex items-center gap-3 text-[13px] md:text-[14px] font-black text-black uppercase tracking-[0.3em] mb-6">
                <span class="w-4 h-[1.5px] bg-black"></span> Logical Conceptual
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {project.formulas.map((f) => (
                  <div class="group p-4 bg-white border border-neutral-200 rounded-xl hover:border-black transition-all duration-300">
                    <p class="text-[10px] text-neutral-400 mb-1.5 uppercase font-black tracking-wider group-hover:text-black transition-colors">{f.name}</p>
                    <code class="text-[11px] font-mono text-neutral-800 break-all leading-relaxed block bg-neutral-50 p-2 rounded-lg border border-neutral-100">
                      {f.code}
                    </code>
                  </div>
                ))}
              </div>
            </div>
          )}

          {project.outcomes && project.outcomes.length > 0 && (
            <div class="border-t border-neutral-100 pt-8">
              <h4 class="flex items-center gap-3 text-[13px] md:text-[14px] font-black text-black uppercase tracking-[0.3em] mb-6">
                <span class="w-4 h-[1.5px] bg-black"></span> Key Outcomes
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {project.outcomes.map((outcome) => (
                  <div class="p-4 rounded-xl bg-white border border-neutral-100 flex gap-4 items-center hover:shadow-md transition-all">
                    <span class="text-2xl flex-shrink-0">{outcome.icon}</span>
                    <div>
                      <span class="text-neutral-900 font-black block text-[13px] md:text-[14px] tracking-tight uppercase">
                        {outcome.title}
                      </span>
                      <span class="text-neutral-500 text-[11px] font-medium leading-tight block mt-0.5">
                        {outcome.desc}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupNavigation = () => {
    const grid = document.getElementById('projects-grid');
    const viewBtns = document.querySelectorAll('.view-details-btn');
    const backBtns = document.querySelectorAll('.back-to-grid');

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-project-target');
        const targetView = document.getElementById(`detail-${targetId}`);

        if (grid && targetView) {
          grid.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => {
            grid.classList.add('hidden');
            targetView.classList.remove('hidden');
            requestAnimationFrame(() => {
              targetView.classList.remove('opacity-0', 'absolute');
              targetView.classList.add('opacity-100', 'relative');
            });
          }, 350);
          document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    backBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const currentView = btn.closest('.project-detail-view');
        if (grid && currentView) {
          currentView.classList.add('opacity-0');
          setTimeout(() => {
            currentView.classList.add('hidden');
            currentView.classList.remove('relative');
            currentView.classList.add('absolute');
            grid.classList.remove('hidden');
            requestAnimationFrame(() => {
              grid.classList.remove('opacity-0', 'pointer-events-none');
            });
          }, 350);
        }
      });
    });
  };

  setupNavigation();
  document.addEventListener('astro:after-navigation', setupNavigation);
</script>