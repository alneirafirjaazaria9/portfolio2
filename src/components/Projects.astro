---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project, index) => (
      <div class="group flex flex-col rounded-2xl border border-white/5 bg-neutral-900/50 p-6">
        <div class="mb-4 overflow-hidden rounded-xl border border-white/5">
          <Image src={Array.isArray(project.image) ? project.image[0] : project.image} alt={project.name} width="400" height="200" class="h-40 w-full object-cover" />
        </div>
        <h3 class="text-lg font-bold text-white mb-2">{project.name}</h3>
        <p class="text-sm text-neutral-400 line-clamp-3 mb-4 flex-grow">{project.summary}</p>
        
        <button onclick={`document.getElementById('modal-${index}').showModal()`} class="text-left text-sm font-medium text-primary hover:text-white transition-colors">
          Read More →
        </button>

        <dialog id={`modal-${index}`} class="m-auto w-[90%] max-w-xl rounded-3xl bg-neutral-950 p-0 text-white backdrop:bg-black/80 border border-white/10 overflow-hidden shadow-2xl">
          <div class="relative">
            <button onclick={`document.getElementById('modal-${index}').close()`} class="absolute top-4 right-4 z-10 bg-black/50 p-2 rounded-full hover:bg-black text-white">✕</button>
            <Image src={Array.isArray(project.image) ? project.image[0] : project.image} alt={project.name} width="800" height="400" class="w-full h-56 object-cover" />
          </div>
          
          <div class="p-6">
            <h2 class="text-2xl font-bold mb-3">{project.name}</h2>
            <p class="text-neutral-400 text-sm leading-relaxed mb-6">{project.summary}</p>
            
            <h4 class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest mb-2">Skills Developed</h4>
            <div class="flex flex-wrap gap-2 mb-6">
              {/* Logika penentuan skill berdasarkan kata kunci pada nama proyek */}
              {(project.name.toLowerCase().includes('excel') 
                ? ['Advanced Excel', 'Budgeting', 'Financial Analysis', 'Internal Control'] 
                : ['UI/UX Design', 'Next.js', 'Budgeting', 'Financial Analysis']
              ).map(skill => (
                <span class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] text-primary">{skill}</span>
              ))}
            </div>

            <div class="flex gap-4">
              {project.linkPreview && <a href={project.linkPreview} target="_blank" class="bg-primary px-6 py-2 rounded-full text-sm font-bold text-white hover:bg-primary/90 transition-all">Live Preview</a>}
            </div>
          </div>
        </dialog>
      </div>
    ))}
  </div>
</Section>