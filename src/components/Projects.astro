---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource, date }, index) => {
      const top = 98 + index * 40;
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-12 rounded-2xl border border-white/5 bg-black shadow-2xl overflow-hidden"
        >
          {/* Ganti bg-[#1c232d]/85 menjadi bg-white/[0.02] agar selaras dengan tema matte black */}
          <div class="bg-difu relative z-[1] grid h-auto min-h-[580px] w-full grid-rows-2 rounded-2xl bg-white/[0.02] backdrop-blur-md before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[3%] before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:h-96">
            
            <div class="px-8 py-10 flex flex-col justify-center">
              <h3 class="mb-2 font-serif text-3xl font-medium text-primary tracking-tight">
                {name}
              </h3>
              
              {date && (
                <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-neutral-500">
                  {date}
                </p>
              )}

              <p class="text-base text-neutral-400 leading-relaxed text-justify">
                {summary}
              </p>
              
              <div class="flex gap-6 pt-10">
                {linkSource && (
                  <a
                    href={linkSource}
                    target="_blank"
                    class="text-sm font-medium text-white/70 hover:text-primary flex items-center gap-2 transition-colors group"
                  >
                    Source Code
                    <span class="text-xs transition-transform group-hover:translate-x-1">→</span>
                  </a>
                )}
                {linkPreview && (
                  <a
                    href={linkPreview}
                    target="_blank"
                    class="text-sm font-medium text-white/70 hover:text-primary flex items-center gap-2 transition-colors group"
                  >
                    Live Preview
                    <span class="text-xs transition-transform group-hover:translate-x-1">→</span>
                  </a>
                )}
              </div>
            </div>

            <div class="flex items-end justify-end overflow-hidden px-4 sm:px-0">
              <Image
                class="h-[90%] w-[95%] rounded-tl-2xl rounded-br-2xl object-cover object-top border-l border-t border-white/10 transition-transform duration-700 hover:scale-105 sm:h-[85%] sm:w-full"
                src={Array.isArray(image) ? image[0] : image} 
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>