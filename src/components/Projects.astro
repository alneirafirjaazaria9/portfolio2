---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projects" href="projects">
  <div id="projects-container" class="relative min-h-[500px]">
    
    {}
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 transition-all duration-500">
      {projects.map((project, index) => (
        <div class="group flex flex-col rounded-[2.5rem] border border-neutral-200 bg-white overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-neutral-200/50">
          <div class="relative w-full aspect-video overflow-hidden bg-neutral-100">
            <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} width={800} height={450} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            />
          </div>
          
          <div class="p-8 md:p-10 flex flex-col flex-grow text-left">
            <h3 class="text-2xl md:text-3xl font-black text-neutral-900 mb-3 tracking-tightest">{project.name}</h3>
            <p class="text-sm md:text-base text-neutral-500 line-clamp-3 mb-8 leading-relaxed font-medium">
              {project.summary}
            </p>
            
            <div class="mt-auto pt-6 border-t border-neutral-100">
              <button 
                type="button"
                data-project-target={index}
                class="view-details-btn w-full text-[10px] font-black text-neutral-900 uppercase tracking-[0.4em] hover:opacity-60 transition-all flex items-center justify-between cursor-pointer group/btn"
              >
                <span>View Details</span>
                <span class="text-xl transform transition-transform duration-300 group-hover/btn:translate-x-2">→</span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    {}
    {projects.map((project, index) => (
      <div id={`detail-${index}`} class="project-detail-view hidden opacity-0 translate-y-4 transition-all duration-500">
        <button class="back-to-grid mb-8 flex items-center gap-3 text-[10px] font-black uppercase tracking-[0.3em] text-neutral-400 hover:text-black transition-colors">
          <span class="text-lg">←</span> Back to Projects
        </button>

        <div class="rounded-[2.5rem] border border-neutral-200 bg-white overflow-hidden p-6 md:p-12">
          <div class="w-full bg-neutral-100 aspect-video md:aspect-[21/9] rounded-2xl overflow-hidden mb-12">
             <Image 
              src={Array.isArray(project.image) ? project.image[0] : project.image} 
              alt={project.name} width={1200} height={600} 
              class="w-full h-full object-cover" 
             />
          </div>

          <h2 class="text-4xl md:text-6xl font-black mb-6 text-neutral-900 tracking-tightest leading-none">{project.name}</h2>
          <p class="text-neutral-600 mb-12 text-sm md:text-lg text-justify leading-relaxed font-medium max-w-5xl opacity-90">{project.summary}</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12 border-y border-neutral-100 py-12">
            <div class="space-y-6">
              <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em]">
                <span class="w-6 h-[2px] bg-black"></span> Key Features
              </h4>
              <ul class="space-y-3">
                {project.features?.map((feature) => (
                  <li class="flex items-start gap-3 text-sm text-neutral-600 font-bold">
                    <svg class="mt-1 flex-shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <div class="space-y-6">
              <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em]">
                <span class="w-6 h-[2px] bg-black"></span> Skills Applied
              </h4>
              <div class="flex flex-wrap gap-2">
                {project.tags?.map((tag) => (
                  <span class="px-4 py-2 rounded-full bg-neutral-50 border border-neutral-200 text-[9px] text-neutral-600 uppercase font-black tracking-widest">{tag}</span>
                ))}
              </div>
            </div>
          </div>

          {/* Key Outcomes */}
          <div class="mb-12">
            <h4 class="flex items-center gap-3 text-[10px] font-black text-black uppercase tracking-[0.4em] mb-8">
              <span class="w-6 h-[2px] bg-black"></span> Key Outcomes
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {project.outcomes?.map((outcome) => (
                <div class="p-6 rounded-2xl bg-neutral-50 border border-neutral-100 flex gap-4 items-center">
                  <span class="text-3xl">{outcome.icon}</span>
                  <div>
                    <span class="text-neutral-900 font-black block text-sm tracking-tight">{outcome.title}</span>
                    <span class="text-neutral-500 text-xs font-medium leading-tight">{outcome.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const setupProjectNavigation = () => {
    const grid = document.getElementById('projects-grid');
    const detailViews = document.querySelectorAll('.project-detail-view');
    const viewBtns = document.querySelectorAll('.view-details-btn');
    const backBtns = document.querySelectorAll('.back-to-grid');

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-project-target');
        const targetView = document.getElementById(`detail-${targetId}`);

        grid?.classList.add('hidden', 'opacity-0');
        
        targetView?.classList.remove('hidden');
        setTimeout(() => {
          targetView?.classList.remove('opacity-0', 'translate-y-4');
          targetView?.classList.add('opacity-100', 'translate-y-0');
        }, 50);

        document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    backBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const openView = document.querySelector('.project-detail-view:not(.hidden)');
        
        openView?.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => {
          openView?.classList.add('hidden');
          grid?.classList.remove('hidden');
          setTimeout(() => grid?.classList.remove('opacity-0'), 50);
        }, 400);
      });
    });
  };

  setupProjectNavigation();
  document.addEventListener('astro:after-navigation', setupProjectNavigation);
</script>