---
import "../styles/global.css";
import Header from "@components/Header.astro";
import "@fontsource/be-vietnam-pro";
import "@fontsource-variable/gabarito";
import { SITE_CONFIG } from "@config";

const {
  title,
  description,
  siteLogo,
  navLinks,
  lang,
} = SITE_CONFIG;

// Kita pakai string kosong dulu supaya tidak "Invalid URL"
const canonicalURL = ""; 
---

<!doctype html>
<html lang={lang} class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body class="bg-black font-montserrat text-white selection:bg-primary/30">
      <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_farthest-side_at_top_right,rgba(128,0,0,0.05),transparent)]"></div>
    <Header siteLogo={siteLogo} navLinks={navLinks} />
    <main class="mx-auto max-w-5xl px-5">
      <slot />
    </main>
  </body>
</html>
