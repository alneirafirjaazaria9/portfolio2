---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Skills from "@components/Skills.astro";
import Experience from "@components/Experience.astro";
import Organization from "@components/Organization.astro";
import Projects from "@components/Projects.astro";
import Certification from "@components/Certification.astro";
import Contact from "@components/Contact.astro";
import Footer from "@components/Footer.astro";
import { SITE_CONTENT, SITE_CONFIG } from "../config/index";
---

<Layout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  
  <main class="space-y-1"> 
    <Hero {...SITE_CONTENT.hero} />
    <Skills skills={SITE_CONTENT.skills} />
    <Experience experience={SITE_CONTENT.experience} />
    <Organization organization={SITE_CONTENT.organization} />
    <Projects projects={SITE_CONTENT.projects} />
    <Certification certification={SITE_CONTENT.certification} />
    <Contact /> 
  </main>
  
  <Footer author={SITE_CONFIG.author} socialLinks={SITE_CONFIG.socialLinks || []} />
</Layout>
<button
  id="back-to-top"
  class="fixed bottom-6 right-6 z-50 p-3 rounded-md bg-neutral-900 text-white shadow-lg border border-neutral-800 opacity-0 invisible translate-y-4 transition-all duration-300 hover:bg-neutral-800 hover:scale-105 active:scale-95 flex items-center justify-center cursor-pointer"
  aria-label="Back to top"
>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width="20" 
    height="20" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="2.5" 
    stroke-linecap="round" 
    stroke-linejoin="round"
  >
    <path d="m18 15-6-6-6 6"/>
  </svg>
</button>

<script>
  const backToTopBtn = document.getElementById('back-to-top');

  if (backToTopBtn) {
    // Fungsi memantau scroll penonton web
    window.addEventListener('scroll', () => {
      // Tombol baru muncul jika user sudah scroll ke bawah sejauh 400px
      if (window.scrollY > 400) {
        backToTopBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
        backToTopBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        backToTopBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
        backToTopBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth' 
      });
    });
  }
</script>