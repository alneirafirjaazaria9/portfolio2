---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Skills from "@components/Skills.astro";
import Experience from "@components/Experience.astro";
import Organization from "@components/Organization.astro"; // PINDAHKAN KE SINI
import Projects from "@components/Projects.astro";
import Certification from "@components/Certification.astro";
import Footer from "@components/Footer.astro";
import { SITE_CONTENT, SITE_CONFIG } from "../config/index";
---

<Layout title={SITE_CONFIG.title} description={SITE_CONFIG.description}>
  <main class="space-y-10">
    <Hero {...SITE_CONTENT.hero} />
    <Skills skills={SITE_CONTENT.skills} />
    <Experience experience={SITE_CONTENT.experience} />
    
    {/* Sekarang baris ini tidak akan merah lagi */}
    <Organization organization={SITE_CONTENT.organization} />
    
    <Projects projects={SITE_CONTENT.projects} />
    <Certification certification={SITE_CONTENT.certification} />
  </main>
  
  <Footer author={SITE_CONFIG.author} socialLinks={SITE_CONFIG.socialLinks || []} />
</Layout>